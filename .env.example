# The Living Garden — Environment Variables Template
# Copy this file to .env.local to configure real Supabase Cloud connectivity.
# If these variables are left empty, the application automatically runs in
# offline / local multi-tab broadcast mode.

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=

# Supabase Anon Public API Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=

# Visitor QR URL override (defaults to current window origin + /create)
VITE_VISITOR_URL=https://thelivinggarden.art/create

